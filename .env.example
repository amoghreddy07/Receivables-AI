# ReceivablesAI — environment template
# Copy to `.env` (or set in the shell) to override defaults. Every variable has
# a safe default in backend/app/config.py; nothing is required to run tests,
# the demo, or the evaluation. Never commit a real .env with keys.

# --- Database ----------------------------------------------------------------
# SQLAlchemy database URL for the application (demo = data/demo.db).
RA_DB_URL=sqlite:///data/demo.db

# --- Policy / safety ---------------------------------------------------------
# Hard compliance boundary: invoices more than this many days overdue are
# hard-stopped (exactly 120 is allowed; 121 is blocked).
RA_COMPLIANCE_MAX_DAYS=120
# Minimum risk score for the agent to act; below this the case is observe-only.
RA_ACTION_RISK_MIN=0.42
# Allowed contact window (24h, start/end hour). Outreach outside it is deferred.
RA_CONTACT_START=9
RA_CONTACT_END=21
# Amount (minor units, paise) at or above which human approval is required even
# in AUTONOMOUS mode. 100000000 paise = Rs 10,00,000.
RA_HIGH_VALUE_AUTO_LIMIT_MINOR=100000000
# Maximum executed actions per customer per month (stopping rule).
RA_CUSTOMER_ACTION_CAP=10
# Maximum executed actions globally per day (stopping rule).
RA_GLOBAL_DAILY_BUDGET=500
# Supervised approvals auto-decline after this many minutes (safe default).
RA_APPROVAL_TIMEOUT_MIN=30

# --- Agent modes -------------------------------------------------------------
# Agent execution mode: supervised (every action needs human approval) | autonomous.
RA_DEFAULT_MODE=supervised
# Diagnosis mode: rules (deterministic only) | auto (fused rules + LLM/offline NLU).
RA_LLM_MODE=rules
# Timeout in seconds for a real LLM diagnosis call.
RA_LLM_TIMEOUT=8
# Model used when a real OpenAI key is configured.
RA_LLM_MODEL=gpt-4o-mini

# --- Optional credentials (leave empty to stay fully offline) -----------------
# Real OpenAI key — enables the live LLM diagnoser (app/diagnosis/llm_diagnoser.py).
# Without it, RA_LLM_MODE=auto uses the deterministic offline NLU diagnoser.
OPENAI_API_KEY=
# Real Razorpay test-mode credentials — enables the RazorpayClient provider.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay webhook secret (HMAC verification for incoming webhook events).
RAZORPAY_WEBHOOK_SECRET=

# --- Operational -------------------------------------------------------------
# 1 = dashboard demo actions (audit tamper test) enabled; requires demo.db.
RA_DEMO_MODE=1
# 1 = hourly background tick (approval expiry, pending money, overdue cases).
RA_HOURLY_TICK=1
# Seed for the deterministic evaluation corpus.
RA_EVAL_SEED=1
# Evaluation simulation horizon in days (45-day sandbox window).
RA_HORIZON_DAYS=45